{
  "manifest_version": 3,
  "name": "Friends Only",
  "version": "2.0.0",
  "description": "Instagram and Facebook with only the people you follow: no algorithm, Reels, suggestions or ads.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["instagram.js"],
      "css": ["instagram.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.facebook.com/*", "https://web.facebook.com/*"],
      "js": ["facebook.js"],
      "css": ["facebook.css"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Friends Only",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "popup.html"
  }
}
